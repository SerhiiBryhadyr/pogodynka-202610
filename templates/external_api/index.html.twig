{% extends 'base.html.twig' %}

{% block title %}Weather Forecast{% endblock %}

{% block body %}
    <h1>Weather Forecast</h1>

    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button type="submit" class="btn btn-primary">Submit</button>
    {{ form_end(form) }}

    {% if error %}
        <div class="alert alert-danger mt-3">{{ error }}</div>
    {% endif %}

    {% if weather_data %}
        <h2 class="mt-4">Data from Open-Meteo</h2>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Max temperature</th>
                        <th>Min temperature</th>
                        <th>Humidity</th>
                        <th>Pressure</th>
                        <th>Cloudiness</th>
                        <th>Precipitation</th>
                        <th>Wind speed</th>
                        <th>Wind direction</th>
                    </tr>
                </thead>
                <tbody>
                {% for date in weather_data.daily.time %}
                    {% set i = loop.index0 %}
                    <tr>
                        <td>{{ date|date('d.m.Y') }}</td>
                        <td>{{ weather_data.daily.temperature_2m_max[i] }}&deg;C</td>
                        <td>{{ weather_data.daily.temperature_2m_min[i] }}&deg;C</td>
                        <td>{{ weather_data.daily.relative_humidity_2m_mean[i] }}%</td>
                        <td>{{ weather_data.daily.pressure_msl_mean[i] }} hPa</td>
                        <td>{{ weather_data.daily.cloud_cover_mean[i] }}%</td>
                        <td>{{ weather_data.daily.precipitation_sum[i] }} mm</td>
                        <td>{{ weather_data.daily.wind_speed_10m_max[i] }} m/s</td>
                        <td>{{ weather_data.daily.wind_direction_10m_dominant[i] }}&deg;</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
