{% extends 'base.html.twig' %}

{# @var location \App\Entity\Location #}
{# @var measurements \App\Entity\Measurement[] #}

{% block title %}Weather in {{ location.city }}, {{ location.country }}{% endblock %}

{% block body %}
    <h1>Weather in {{ location.city }}, {{ location.country }}</h1>
    <p class="text-muted">Latitude: {{ location.latitude }}, longitude: {{ location.longitude }}</p>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Temperature</th>
                    <th>Humidity</th>
                    <th>Pressure</th>
                    <th>Cloudiness</th>
                    <th>Precipitation</th>
                    <th>Wind speed</th>
                    <th>Wind direction</th>
                </tr>
            </thead>
            <tbody>
            {% for measurement in measurements %}
                <tr>
                    <td>{{ measurement.date|date('d.m.Y') }}</td>
                    <td>{{ measurement.celsius }}&deg;C</td>
                    <td>{{ measurement.humidity }}%</td>
                    <td>{{ measurement.pressure }} hPa</td>
                    <td>{{ measurement.cloudiness }}%</td>
                    <td>{{ measurement.precipitation }} mm</td>
                    <td>{{ measurement.windSpeed }} m/s</td>
                    <td>{{ measurement.windDirection }}&deg;</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8">No forecast available.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
